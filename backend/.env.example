# ================= 服务器配置 =================
APP_ENV=dev
APP_PORT=8080
# 配置 TLS_CERT/TLS_KEY 启用 HTTPS 时，额外开启的本地回环 HTTP 端口
# （仅 127.0.0.1 可达，供 Vite 开发代理访问 /storage 静态资源；0 表示关闭）
APP_HTTP_PORT=0
APP_NAME=meeting-platform
CORS_ORIGIN=http://localhost:5173

